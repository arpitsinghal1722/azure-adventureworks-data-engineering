													{
														"referenceName": "DS_ADLS_Parquet",
														"type": "DatasetReference",
														"parameters": {
															"ContainerName": "adventureworks",
															"FolderPath": {
																"value": "@if(\n    startsWith(item().TargetFolder,'/'),\n    concat(\n        substring(item().TargetFolder,1,sub(length(item().TargetFolder),1)),\n        formatDateTime(utcnow(),'yyyy/MM/dd')\n    ),\n    concat(\n        item().TargetFolder,\n        formatDateTime(utcnow(),'yyyy/MM/dd')\n    )\n)",
																"type": "Expression"
															},
															"FileName": {
																"value": "@concat(\n    item().SourceTable,\n    '_',\n    formatDateTime(utcnow(),'yyyyMMdd_HHmmss'),\n    '.parquet'\n)",
