														"typeConversion": true,
														"typeConversionSettings": {
															"allowDataTruncation": true,
															"treatBooleanAsNumber": false
														}
													}
												},
												"inputs": [
													{
														"referenceName": "DS_SQL_AdventureWorks",
														"type": "DatasetReference",
														"parameters": {
															"SchemaName": {
																"value": "@item().SourceSchema",
																"type": "Expression"
															},
															"TableName": {
																"value": "@item().SourceTable",
																"type": "Expression"
															}
