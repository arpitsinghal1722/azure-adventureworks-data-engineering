									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"on": {
									"value": "@if(\n    and(\n        and(\n            equals(item().SourceSystem,'OnPremSQL'),\n            equals(item().LoadType,'FULL')\n        ),\n        or(\n            and(\n                equals(item().SourceSchema,'Person'),\n                equals(item().SourceTable,'Address')\n            ),\n            and(\n                equals(item().SourceSchema,'HumanResources'),\n                equals(item().SourceTable,'Employee')\n            )\n        )\n    ),\n    if(\n        and(\n            equals(item().SourceSchema,'Person'),\n            equals(item().SourceTable,'Address')\n        ),\n        'OnPremSQL_FULL_ADDRESS',\n        'OnPremSQL_FULL_EMPLOYEE'\n    ),\n    concat(item().SourceSystem,'_',item().LoadType)\n)",
									"type": "Expression"
								},
								"cases": [
									{
										"value": "OnPremSQL_FULL",
										"activities": [
											{
												"name": "CP_Full_To_ADLS",
